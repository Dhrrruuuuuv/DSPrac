//Prac3 in Java

package DSPrac3;

class SumThread extends Thread
{
    int[] arr;
    int start;
    int end;

    int localSum = 0;

    public SumThread(int[] arr, int start, int end)
    {
        this.arr = arr;
        this.start = start;
        this.end = end;
    }

    public void run()
    {
        System.out.println(
                "Thread handling elements from index "
                        + start + " to " + (end - 1));

        for (int i = start; i < end; i++)
        {
            localSum += arr[i];
        }

        System.out.println(
                "Local Sum = " + localSum);
    }

    public int getLocalSum()
    {
        return localSum;
    }
}

public class Ditributedum {
    public static void main(String[] args)
            throws InterruptedException
    {
        int[] arr = {1, 2, 3, 4, 5, 6, 7, 8};

        int numberOfThreads = 4;

        int elementsPerThread =
                arr.length / numberOfThreads;

        SumThread[] threads =
                new SumThread[numberOfThreads];

        int totalSum = 0;

        for (int i = 0; i < numberOfThreads; i++)
        {
            int start = i * elementsPerThread;

            int end = start + elementsPerThread;

            threads[i] =
                    new SumThread(arr, start, end);

            threads[i].start();
        }

        for (int i = 0; i < numberOfThreads; i++)
        {
            threads[i].join();

            totalSum += threads[i].getLocalSum();
        }

        System.out.println("\nTotal Sum = " + totalSum);
    }
}
